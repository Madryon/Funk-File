# Funk Files / PDF & Image Toolbox - Environment Configuration Example
# Copy this file to .env: cp .env.example .env

# Secret key for session encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-random-32-byte-hex-secret-key

# ================= DATABASE CONFIGURATION =================
# Default: Local SQLite database
# DATABASE_URL=sqlite:///app.db

# --- Option A: Aiven PostgreSQL Service URI (Recommended) ---
# Copy the "Service URI" directly from your Aiven Console overview page:
# Format: postgres://avnadmin:<PASSWORD>@<HOST>:<PORT>/defaultdb?sslmode=require
# Note: The app automatically normalizes 'postgres://' to 'postgresql+psycopg2://'
# and enforces 'sslmode=require'.
# DATABASE_URL=postgres://avnadmin:your_aiven_password@pg-12345678-yourproject.aivencloud.com:21356/defaultdb?sslmode=require

# --- Option B: Discrete Parameters (Convenient if password has special characters like @, #, %) ---
# PGHOST=pg-12345678-yourproject.aivencloud.com
# PGPORT=21356
# PGUSER=avnadmin
# PGPASSWORD=your_aiven_password_here
# PGDATABASE=defaultdb
# PGSSLMODE=require

# ================= ADMIN DASHBOARD =================
# Master Password required to log in to /admin
# Set a strong, secure password in production (e.g. Render/Aiven/Heroku Environment Variables)
ADMIN_PASSWORD=your-secure-admin-password-here

# ================= SECURITY & COOKIES =================
# Set to 'true' in production (HTTPS), 'false' for local development (HTTP)
COOKIE_SECURE=false

# ================= CAPTCHA CONFIGURATION =================
# Options: custom (built-in 3x3 image grid challenge)
CAPTCHA_PROVIDER=custom

# Optional external captcha providers:
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
