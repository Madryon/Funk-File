# Funk Files - Environment Configuration Example

# Flask Secret Key (use a secure random string in production)
SECRET_KEY=change-this-to-a-secure-random-32-char-string

# Database URL (defaults to SQLite if unset)
# DATABASE_URL=sqlite:///app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/funkfiles

# Admin Password for /admin panel
ADMIN_PASSWORD=AdminPass2026!

# Cookie Security (set to true in production HTTPS)
COOKIE_SECURE=false

# CAPTCHA Provider Configuration
# Options: "custom" (default 3x3 image grid), "turnstile", "recaptcha"
CAPTCHA_PROVIDER=custom

# Cloudflare Turnstile (only needed when CAPTCHA_PROVIDER=turnstile)
# TURNSTILE_SITE_KEY=0x4AAAAAAAX...
# TURNSTILE_SECRET_KEY=0x4AAAAAAAX...

# Google reCAPTCHA v2 (only needed when CAPTCHA_PROVIDER=recaptcha)
# RECAPTCHA_SITE_KEY=6LeIxacTAAAAA...
# RECAPTCHA_SECRET_KEY=6LeIxacTAAAAA...
