# Render Environment Variables
# In Render Web Service -> Environment -> Add Environment Variable:
#
# Key: SECRET_KEY
# Value: a-secure-random-32-character-secret-key
SECRET_KEY=generate_a_random_secret_key_here

# Key: DATABASE_URL
# Value: Internal Database URL from your Render PostgreSQL instance
# (e.g. postgres://user:password@dpg-xxxx-a:5432/dbname)
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
